{
  "manifest_version": 3,
  "name": "TradeNav",
  "version": "1.0.0",
  "description": "AI-powered navigation assistant for TradingView",

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://tradenav-jxtr.onrender.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://tradingview.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}